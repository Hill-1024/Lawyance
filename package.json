{
  "name": "lawver",
  "private": true,
  "version": "0.1.22",
  "description": "工大法智团队的中文法律 AI 助手原型",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "metadata": {
    "name": "Lawver"
  },
  "appConfig": {
    "environment": "Web/Vite",
    "projectUrl": "https://github.com/Hill-1024/Lawyance",
    "domain": "lawver.dev",
    "nativeApiBase": "https://cn-origin.lawver.dev",
    "port": 8081,
    "devPort": 5173,
    "routerPort": 8080,
    "introPort": 8082
  },
  "scripts": {
    "dev": "python agent.py",
    "dev:frontend": "LAWVER_BUILD_ENV=Development vite",
    "sync-android-config": "node scripts/sync-android-config.mjs",
    "build": "pnpm run sync-android-config && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "mobile:doctor": "cap doctor && cap ls",
    "mobile:assets": "capacitor-assets generate --android --iconBackgroundColor '#f6f8fb' --splashBackgroundColor '#f6f8fb'",
    "mobile:android:sync": "LAWVER_BUILD_ENV=Capacitor/Android pnpm run build && cap sync android",
    "mobile:android:open": "pnpm run mobile:android:sync && cap open android",
    "mobile:android:test": "node scripts/run-android-gradle.mjs testDebugUnitTest",
    "mobile:android:apk": "pnpm run mobile:android:sync && node scripts/run-android-gradle.mjs assembleDebug && echo 'APK: android/app/build/outputs/apk/debug/app-debug.apk'",
    "test:backup-crypto": "tsx scripts/test-backup-crypto.ts",
    "test:storage-cleanup": "tsx scripts/test-storage-cleanup.ts",
    "test:stream-run-guards": "tsx scripts/test-stream-run-guards.ts",
    "test:app-back": "tsx scripts/test-app-back.ts",
    "test:attachment-prompt": "tsx scripts/test-attachment-prompt.ts",
    "test:composer-autosize": "tsx scripts/test-composer-autosize.ts",
    "start": "python agent.py"
  },
  "dependencies": {
    "@capacitor/android": "8.3.4",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.4",
    "@capacitor/file-transfer": "2.0.4",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@material/material-color-utilities": "0.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@vitejs/plugin-react": "^6.0.3",
    "android-dynamic-color": "github:Hill-1024/Monet-Color-For-Capacitor#15fa13f9ca08ce36e3c111d5241a2e95f880f27d",
    "docx-preview": "^0.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.3.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "8.0.16"
  }
}
