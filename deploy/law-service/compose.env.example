LAW_COMPOSE_PROJECT_NAME=lawver-law
LAW_IMAGE=lawver-law:REPLACE_WITH_RELEASE_TAG
LAW_PUBLISH_PORT=8084
# Absolute host paths. Corpus and keys are read-only; state must match image UID/GID.
LAW_DATA_HOST_DIR=/srv/lawver-law/data
LAW_KEYS_HOST_DIR=/etc/lawver-law
LAW_STATE_HOST_DIR=/var/lib/lawver-law
