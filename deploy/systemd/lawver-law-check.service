[Unit]
Description=Check Lawver law service and audit thresholds
# Add OnFailure=your-existing-alert.service in a local override to connect alerts.
After=lawver-law.service

[Service]
Type=oneshot
User=lawver-law
Group=lawver-law
WorkingDirectory=/srv/lawver-law/current
EnvironmentFile=/etc/lawver-law/environment
# Enable canary checking with an ExecStart override after issuing a dedicated key.
ExecStart=/usr/bin/python3 scripts/law_service_ops.py check --url http://127.0.0.1:8084 --audit /var/lib/lawver-law/audit/audit.jsonl
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
