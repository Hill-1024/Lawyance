COMPOSE_PROJECT_NAME=lawver-customer
# Use the customer build target and an immutable version or digest.
LAWVER_CUSTOMER_IMAGE=lawver-customer:REPLACE_WITH_RELEASE_TAG
LAWVER_INTRO_IMAGE=lawver-intro:REPLACE_WITH_RELEASE_TAG
LAWVER_ROUTER_PUBLISH_PORT=8080
LAWVER_NETWORK_SUBNET=172.28.0.0/16
# Replace these sample host paths with directories on this customer server.
LAWVER_DATA_HOST_DIR=/var/lib/lawver-customer
LAWVER_APP_ENV_FILE=/etc/lawver-customer/app.env
LAWVER_ROUTER_STATE_DIR=/var/lib/lawver-customer/router-state
LAWVER_INTRO_HOME=/srv/lawver-intro
LAWVER_DATABASE_URL=postgresql+psycopg://lawver:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/lawver
LAWVER_REDIS_URL=redis://redis:6379/0
LAWVER_REDIS_PREFIX=lawver-customer
SEARXNG_BASE_URL=http://searxng:8080/
LAWVER_LAW_SERVICE_URL=https://law-api.example.invalid
# LAWVER_LAW_SERVICE_KEY belongs in LAWVER_APP_ENV_FILE only.
