# 实例作用域变量（compose.yml / compose.self-hosted.yml / compose.frontier.yml 用）。
#
# 每个实例一份：cp compose.env.example <实例目录>/compose.env
# 建议让 new-instance.sh 生成——它会自动挑不冲突的端口与网段、建好目录，
# 并把可直接运行的 run.sh 一起写好：
#
#   deploy/docker/new-instance.sh billing 8081
#
# ⚠️ 这份文件与应用的 .env 是**两个东西**：
#   · 这里放容器编排层的东西（项目名、发布端口、网段、挂载路径）；
#   · 应用自己的业务配置（LLM 密钥、得理/企查查令牌、限流参数……）仍写在应用 .env 里，
#     由 LAWVER_APP_ENV_FILE 指向并只读挂进容器。

# ── 实例标识 ────────────────────────────────────────────────────────────────
# 隔离容器名、网络、卷。一台机器上多实例必须各不相同。
COMPOSE_PROJECT_NAME=lawver

# ── 对外端口（隧道指向它）──────────────────────────────────────────────────
# 唯一发布的端口。宿主上多个实例时这里必须各不相同；容器内部的 8080/8081/8082
# 各在自己的网络命名空间里，不受影响、也不用改。
LAWVER_ROUTER_PUBLISH_PORT=8080
# 绑定地址。保持 127.0.0.1：对外的出入口是隧道，容器不该直接暴露到局域网。
# 仅当隧道跑在另一台机器上、确实需要监听内网网卡时才改。
LAWVER_ROUTER_PUBLISH_HOST=127.0.0.1

# ── 网络 ───────────────────────────────────────────────────────────────────
# 实例网段。同一个值会被喂给 LAWVER_TRUSTED_PROXY_CIDRS（核心容器必须落在可信段内，
# 否则限流与访问日志取不到真实客户端 IP），两处因此不可能漂移。
# 多实例时各取一段：172.28.0.0/16、172.29.0.0/16……
LAWVER_NETWORK_SUBNET=172.28.0.0/16

# ── 挂载路径 ───────────────────────────────────────────────────────────────
# 应用持久化根：其下展开 data/（settings、secrets、usage.log、APK）、TEMP/、Result/。
# 属主必须是容器内运行用户（默认 uid 1000，与部署机的 lawver 对齐）。
LAWVER_DATA_HOST_DIR=/var/lib/lawver

# 应用的 .env（业务配置，含密钥）。只读挂进容器的 /app/.env。
LAWVER_APP_ENV_FILE=/srv/lawver/.env

# 介绍页仓库检出目录（只读挂入）。多实例可共用同一份。
# 宿主上跑 tools/build.sh 换版，容器不用重启。
LAWVER_INTRO_HOME=/srv/lawver-intro

# 分流核心的维护开关目录（宿主可 touch app.maintenance / intro.maintenance）。
LAWVER_ROUTER_STATE_DIR=/var/lib/lawver/router-state

# 语料目录（只读）。仅 self-hosted overlay 需要；多实例可共用同一份检出。
# LAWVER_LAW_DATA_DIR=/srv/lawver/RAG/data

# ── 基建连接（指向共享基建的服务名）────────────────────────────────────────
# 口令要与 infra.env 里的 LAWVER_POSTGRES_PASSWORD 一致。
LAWVER_DATABASE_URL=postgresql+psycopg://lawver:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/lawver
LAWVER_REDIS_URL=redis://redis:6379/0
SEARXNG_BASE_URL=http://searxng:8080/

# ⚠️ 全机共享同一个 Redis 时，每个实例的前缀必须不同：
# 限流计数、登录节流与会话布隆过滤器都按前缀分区，重了就是几个实例共用一个计数器，
# 实际上限被放大、还互相误伤。new-instance.sh 会拒绝重复前缀。
LAWVER_REDIS_PREFIX=lawver

# ── 镜像 ───────────────────────────────────────────────────────────────────
# 默认拉 GHCR 上的镜像；本地构建过同名镜像时 compose 会用本地那份。
# LAWVER_APP_IMAGE=ghcr.io/hill-1024/lawver-app:latest
# LAWVER_INTRO_IMAGE=ghcr.io/hill-1024/lawver-intro:latest

# ── 法条检索数据源（仅 frontier overlay 需要）──────────────────────────────
# 前沿实例没有语料，必须走远程；自营实例（self-hosted overlay）保持 local。
# PKU_LAW_SOURCE=remote
