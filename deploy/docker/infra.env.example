# 全机共享基建的变量（compose.infra.yml 用）。
#
#   cp infra.env.example infra.env && chmod 600 infra.env && 改掉口令
#   docker compose --env-file infra.env -f compose.infra.yml up -d
#
# 这份文件**全机一份**，与实例的 compose.env（每实例一份）分开。

# PostgreSQL 口令。实例侧不重复放明文口令——实例的 LAWVER_DATABASE_URL 里引用的是
# 同一个值，两处要一起改。生成：openssl rand -base64 24
LAWVER_POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
LAWVER_POSTGRES_DB=lawver
LAWVER_POSTGRES_USER=lawver
