"""
模块描述：本地开发临时桩服务（8080），模拟认证与管理接口，供前端联调 UI 使用。
"""

import json
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

state = {"auth_on": True}
DEMO_USER = {"username": "demo", "role": "admin", "owner": None, "max_online": None, "max_users": None}

class StubHandler(BaseHTTPRequestHandler):
    def _reply(self, payload, status=200):
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        length = int(self.headers.get("Content-Length") or 0)
        if length <= 0:
            return {}
        try:
            return json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError:
            return {}

    def do_GET(self):
        if self.path.startswith("/api/verify_auth"):
            if state["auth_on"]:
                self._reply({"status": "ok", **DEMO_USER, "online_count": 1})
            else:
                self._reply({"detail": "Not authenticated"}, status=401)
        elif self.path.startswith("/api/admin/accounts"):
            self._reply({"status": "ok", "accounts": [DEMO_USER]})
        else:
            self._reply({})

    def do_POST(self):
        if self.path.startswith("/api/__auth/on"):
            state["auth_on"] = True
            self._reply({"status": "ok", "auth_on": True})
        elif self.path.startswith("/api/__auth/off"):
            state["auth_on"] = False
            self._reply({"status": "ok", "auth_on": False})
        elif self.path.startswith("/api/login"):
            payload = self._body()
            state["auth_on"] = True
            self._reply({
                "status": "ok",
                "message": "登录成功",
                "username": payload.get("username", "demo"),
                "role": "admin",
                "token": "mock-token",
            })
        elif self.path.startswith("/api/logout"):
            state["auth_on"] = False
            self._reply({"status": "ok"})
        else:
            self._reply({})

    def log_message(self, fmt, *args):
        print("[mock]", fmt % args)

if __name__ == "__main__":
    print("Lawver mock backend listening on http://127.0.0.1:8080")
    ThreadingHTTPServer(("127.0.0.1", 8080), StubHandler).serve_forever()