# 根据自己情况修改添加
# LLM 模型相关 API
API_KEY = ""
BASE_URL = ""
LLM_MODEL = ""

# 工具调用默认不按轮次截断。若部署方需要兜底保护，可设置为正整数。
# LAWVER_MAX_TOOL_ROUNDS = ""
# LAWVER_MAX_NON_STREAM_TOOL_ROUNDS = ""

# 应用认证配置
# SECRET_KEY 必须至少 32 位；生产环境请使用随机值，例如 openssl rand -hex 32
SECRET_KEY = ""
# 首次启动且账号数据库为空时用于创建内置 admin（sudo）账号；创建后可移除
INITIAL_ADMIN_PASSWORD = ""
# 在线设备判定窗口（秒）：最近活跃时间在此窗口内的会话计为在线，默认 900
# LAWVER_ONLINE_WINDOW_SECONDS = "900"
# 在线设备超限策略：kick=踢掉最久未活跃设备（默认），reject=拒绝新登录
# LAWVER_ONLINE_LIMIT_ACTION = "kick"
# 原生 Capacitor 客户端 Origin 白名单；Web 生产域默认内置允许
LAWVER_ALLOWED_ORIGINS = "https://localhost,capacitor://localhost"
# Android 客户端构建时注入的后端地址；未设置时前端会回退到生产域
VITE_LAWVER_API_BASE = "https://law.mutsumi.moe"

# 请求防护：限流计数 + 会话布隆过滤器。设置 LAWVER_REDIS_URL 后两者都由 Redis 共享，
# 多 worker / 多实例部署下计数一致、布隆过滤器只预热一次；未设置时退回进程内实现。
# Redis 只是防护层：连不上、URL 写错或命令报错都会自动降级，不影响登录与鉴权。
# 使用普通 Redis 即可，不需要 RedisBloom 模块（位图由 SETBIT/GETBIT 实现）。
# LAWVER_REDIS_URL = "redis://127.0.0.1:6379/0"
# LAWVER_REDIS_PREFIX = "lawver"
# LAWVER_REDIS_TIMEOUT = "0.25"
# 全局 API 限流：单 IP 每分钟上限，默认 100
# LAWVER_API_RATE_LIMIT = "100"
# 登录接口单独限流：单 IP 每分钟登录尝试上限，默认 30；用于挡住同 IP 撞库（账号级锁定拦不住用户名喷洒）
# LAWVER_LOGIN_RATE_LIMIT = "30"
# 限流总开关：设为 0 时完全关闭（仅建议测试环境使用）
# LAWVER_RATE_LIMIT_ENABLED = "1"
# 会话布隆过滤器总开关：设为 0 时每个请求都回源数据库
# LAWVER_BLOOM_ENABLED = "1"
# 布隆过滤器容量与误判率；容量按「有效会话数量级」估算，误判只会多查一次库
# LAWVER_BLOOM_SESSION_CAPACITY = "200000"
# LAWVER_BLOOM_ERROR_RATE = "0.001"

# Android APK 分发缓存。生产后端启动时会从 GitHub 最新 Release 拉取 android-version.json 与 APK。
# LAWVER_RELEASE_SYNC_ON_STARTUP = "1"
# LAWVER_RELEASE_REPO = "Hill-1024/Lawyance"
# LAWVER_RELEASE_DIR = "data/releases/android"
# LAWVER_PUBLIC_BASE_URL = "https://law.mutsumi.moe"
# LAWVER_APK_DOWNLOAD_RPM = "6"
# 私有仓库或 GitHub API 限流时可提供只读 token。
# LAWVER_GITHUB_TOKEN = ""

# 聊天断线续传。响应内容仅在用户开启续传后进入进程内存缓冲，不落盘。
# LAWVER_RESUME_MAX_STREAMS_PER_USER = "3"
# LAWVER_RESUME_MAX_BYTES_PER_STREAM = "2097152"
# LAWVER_RESUME_MAX_BYTES_GLOBAL = "134217728"
# LAWVER_RESUME_TTL_SECONDS = "2700"
# LAWVER_RESUME_SWEEP_SECONDS = "60"
# 多 worker 下内存续传不可靠；设为 1 时会在 UVICORN_WORKERS>1 时拒绝启动。
# LAWVER_RESUME_REQUIRE_SINGLE_WORKER = "0"

# OCP (Output Check Process) 审查 LLM 配置（可选，未设置时回退到主模型配置）
# OCP_API_KEY = ""
# OCP_BASE_URL = ""
# OCP_LLM_MODEL = ""

# 对话记忆 embedding 权重召回（可选，默认关闭；开启后作为多路召回的一路参与 RAG 权重排序）
# MEMORY_EMBEDDING_ENABLED = "1"
# EMBEDDING_API_KEY = ""
# EMBEDDING_BASE_URL = "https://api.siliconflow.cn/v1"
# EMBEDDING_MODEL = "Qwen/Qwen3-Embedding-8B"
# MEMORY_EMBEDDING_TIMEOUT = "8"
# MEMORY_EMBEDDING_MAX_RESPONSE_BYTES = "8388608"

# 对话级记忆服务端活跃缓存（用户侧快照仍是主持久源）
# LAWVER_MEMORY_DB = "data/memory_cache.sqlite3"
# LAWVER_MEMORY_CACHE_TTL_SECONDS = "604800"
# LAWVER_MEMORY_MAX_SCOPES = "512"
# LAWVER_MEMORY_LOG_LEVEL = "INFO"

# ## ModelScope搜索 - 获取API密钥：https://modelscope.cn/
# MODELSCOPE_API_KEY=""
# MODELSCOPE_BASE_URL="https://api-inference.modelscope.cn/v1/"
# MODELSCOPE_MODEL_ID="Qwen/Qwen3.5-397B-A17B" # ModelScope 只能使用 Qwen3.5


# Tools 相关配置#

# 得理 API：https://openapi.delilegal.com/
DELI_APPID=""
DELI_SECRET=""

# 北大法宝api：https://mcp.pkulaw.com/console
PKU_ACCESS_TOKEN="YOUR_ACCESS_HERE"

# 联网搜索 - 自托管 SearXNG，无需第三方搜索 API Key
# SEARXNG_BASE_URL="https://serp.mutsumi.moe/"
# Cloudflare Access Service Auth（如果 SearXNG 域名启用了 Access，则必须同时设置）
# CF_ACCESS_CLIENT_ID=""
# CF_ACCESS_CLIENT_SECRET=""
# 兼容旧变量名
# SEARXNG_CF_ACCESS_CLIENT_ID=""
# SEARXNG_CF_ACCESS_CLIENT_SECRET=""
# 可选：覆盖 SearXNG 默认搜索参数；通常让服务端 settings.yml 和 categories 路由决定 engines
# 只有在需要固定精确引擎时才设置 SEARXNG_ENGINES
# SEARXNG_ENGINES=""
# SEARXNG_CATEGORIES="general"
# SEARXNG_LANGUAGE="all"
# SEARXNG_SAFE_SEARCH="0"
# SEARXNG_TIMEOUT="20"
# SEARXNG_MAX_RESULTS="10"
# SEARXNG_MAX_RESPONSE_BYTES="2097152"
