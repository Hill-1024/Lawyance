{
  "name": "民事行政起诉状",
  "version": "1.0.0",
  "category": "民事诉讼",
  "description": "公民、法人或其他组织为维护自身合法权益，依据事实和法律向人民法院提起诉讼时使用的法律文书。适用于民事案件和行政案件。",
  "output_format": "docx",
  "fields": [
    {"key": "document_title", "label": "文书标题", "type": "string", "required": true, "default": "民事起诉状", "description": "文书标题，如'民事起诉状'或'行政起诉状'"},
    {"key": "plaintiff_name", "label": "原告姓名/名称", "type": "string", "required": true, "description": "原告（自然人）的完整姓名，或法人/其他组织的全称"},
    {"key": "plaintiff_gender", "label": "原告性别", "type": "string", "required": true, "description": "男/女"},
    {"key": "plaintiff_birth", "label": "原告出生日期", "type": "string", "required": true, "description": "如'1990年1月1日'"},
    {"key": "plaintiff_id_card", "label": "原告身份证号", "type": "string", "required": true, "description": "公民身份号码"},
    {"key": "plaintiff_address", "label": "原告住址", "type": "string", "required": true, "description": "住所地详细地址"},
    {"key": "plaintiff_phone", "label": "原告联系电话", "type": "string", "required": true, "description": "可联系的电话号码"},
    {"key": "defendant_name", "label": "被告姓名/名称", "type": "string", "required": true, "description": "被告的完整姓名或法人全称"},
    {"key": "defendant_gender", "label": "被告性别", "type": "string", "required": true, "description": "男/女（自然人为被告时）"},
    {"key": "defendant_birth", "label": "被告出生日期", "type": "string", "required": true, "description": "如'1985年5月20日'（自然人为被告时）"},
    {"key": "defendant_id_card", "label": "被告身份证号", "type": "string", "required": true, "description": "公民身份号码（自然人为被告时）"},
    {"key": "defendant_address", "label": "被告住址", "type": "string", "required": true, "description": "住所地详细地址"},
    {"key": "defendant_phone", "label": "被告联系电话", "type": "string", "required": true, "description": "可联系的电话号码"},
    {"key": "claims", "label": "诉讼请求", "type": "text", "required": true, "description": "具体的诉讼请求"},
    {"key": "facts_and_reasons", "label": "事实与理由", "type": "text", "required": true, "description": "详细陈述案件事实经过及起诉的法律依据"},
    {"key": "evidence", "label": "证据清单", "type": "text", "required": true, "description": "列明证据名称、来源，证人姓名和住址"},
    {"key": "court_name", "label": "管辖法院", "type": "string", "required": true, "description": "受理案件的人民法院全称，如'北京市海淀区'"},
    {"key": "date_filed", "label": "起诉日期", "type": "string", "required": true, "description": "具状日期"}
  ]
}
