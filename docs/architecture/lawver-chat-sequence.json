  "cards": [
    {
      "dot": "emerald",
      "title": "主链路",
      "items": [
        "前端通过一条 SSE 连接接收全部流式事件",
        "记忆先检索、后写回，不阻塞首 token",
        "OCP 审查在回复送达用户前完成"
      ]
    },
    {
      "dot": "cyan",
      "title": "工具循环",
      "items": [
        "ToolLoopAgent 统一承载默认与 Plan-and-Solve 模式",
        "工具调用一律经 mcps 转发，按暴露面鉴权",
        "tool_calls 可多轮，直到模型给出最终回复"
      ]
    },
    {
      "dot": "rose",
      "title": "可靠性",
      "items": [
        "ack 按 seq 确认消费进度，断线可 resume",
        "cancel 主动取消流式生成",
        "OCP 审查失败时按降级策略保护输出"
      ]
    }
  ]
